# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# FreeModel API key is read server-side only. Add it in the hosting platform's
# secret manager; never use NEXT_PUBLIC_* and never commit the real key.
FREEMODEL_API_KEY=""

# Optional model overrides. Defaults are selected automatically:
# Routine / concise requests: gpt-6-luna
# Detailed readings / Master Oracle: claude-haiku-5.5
# IDs must exist in your authenticated GET https://freemodel.in/v1/models response.
FREEMODEL_MODEL="gpt-6-luna"
FREEMODEL_REASONING_MODEL="claude-haiku-5.5"

# NaraRouter OpenAI-compatible gateway. Read server-side only.
# Default route is auto/bynara; the gateway selects from models available to this key/plan.
# Keep this key in Cloudflare Worker secrets or another server-side secret manager.
NARAROUTER_API_KEY=""
NARAROUTER_BASE_URL="https://router.bynara.id/v1"
NARAROUTER_MODEL="auto/bynara"
# Optional separate route for detailed chart reports and Master Oracle.
# Defaults to NARAROUTER_MODEL when omitted.
NARAROUTER_REASONING_MODEL="auto/bynara"
# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GEOAPIFY_API_KEY: Worldwide geocoding, town/village autocomplete, and timezone detection.
GEOAPIFY_API_KEY="MY_GEOAPIFY_API_KEY"
