# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: FreeModel is preferred when both values below are configured.
# Use an exact model ID from the authenticated GET https://freemodel.in/v1/models response.
# Server-only values: never expose them with NEXT_PUBLIC_* or commit real keys.
FREEMODEL_API_KEY=""
FREEMODEL_MODEL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GEOAPIFY_API_KEY: Worldwide geocoding, town/village autocomplete, and timezone detection.
GEOAPIFY_API_KEY="MY_GEOAPIFY_API_KEY"
