# APInex is Celestia's primary AI provider. Keep the key server-side only.
# Add the real value as a Cloudflare Worker secret; never commit it.
APINEX_API_KEY=""
APINEX_BASE_URL="https://api.apinex.bond/v1"
APINEX_REASONING_MODEL="free/deepseek-v4.1-flash"
APINEX_BUDGET_MODEL="free/mimo-v2.6-pro"

# Optional FreeModel fallback. Server-side only.
FREEMODEL_API_KEY=""
FREEMODEL_MODEL="gpt-6-luna"
FREEMODEL_REASONING_MODEL="claude-haiku-5.5"

# Optional NaraRouter fallback. Server-side only.
NARAROUTER_API_KEY=""
NARAROUTER_BASE_URL="https://router.bynara.id/v1"
NARAROUTER_MODEL="auto/bynara"
NARAROUTER_REASONING_MODEL="auto/bynara"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# GEOAPIFY_API_KEY: Worldwide geocoding, town/village autocomplete, and timezone detection.
GEOAPIFY_API_KEY="MY_GEOAPIFY_API_KEY"
