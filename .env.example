# Pollinations is Celestia's primary AI provider.
# Store the real key only as a Cloudflare Worker secret; never commit it.
POLLINATIONS_API_KEY=""

# Optional independent providers. No automatic provider fallback is performed.
FREEMODEL_API_KEY=""
FREEMODEL_MODEL="gpt-6-luna"
FREEMODEL_REASONING_MODEL="claude-haiku-5.5"

NARAROUTER_API_KEY=""
NARAROUTER_BASE_URL="https://router.bynara.id/v1"

OPENROUTER_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GEOAPIFY_API_KEY: Worldwide geocoding, town/village autocomplete, and timezone detection.
GEOAPIFY_API_KEY="MY_GEOAPIFY_API_KEY"
